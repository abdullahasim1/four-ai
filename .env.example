# Neon PostgreSQL connection string (https://neon.tech)
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Email of the account that gets admin role (must sign up / log in with this email)
ADMIN_EMAIL=admin@example.com

# Resend API key for sending confirmation emails (https://resend.com/api-keys)
# Without it, verification links are printed to the server console instead
RESEND_API_KEY=re_xxxxxxxxxx
EMAIL_FROM="Four AI <onboarding@resend.dev>"

# Hugging Face token for server-side image generation (https://huggingface.co/settings/tokens)
HUGGING_FACE_API_KEY=hf_xxxxxxxxxxxxxxxxxx
